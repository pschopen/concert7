<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Concert7 @VERSION@</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <license file="license.txt" mime-type="text/plain"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="au" title="Audio Unit (AU)" description="For Logic Pro, GarageBand and other AU hosts. Installs to /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.github.pschopen.concert7.au"/>
    </choice>
    <choice id="vst3" title="VST3" description="For REAPER, Cubase, Ableton Live, Bitwig and other VST3 hosts. Installs to /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.github.pschopen.concert7.vst3"/>
    </choice>
    <choice id="app" title="Standalone application" description="Concert7 as an app for audio inputs. Installs to /Applications.">
        <pkg-ref id="com.github.pschopen.concert7.app"/>
    </choice>
    <pkg-ref id="com.github.pschopen.concert7.au" version="@PKG_VERSION@">Concert7-au.pkg</pkg-ref>
    <pkg-ref id="com.github.pschopen.concert7.vst3" version="@PKG_VERSION@">Concert7-vst3.pkg</pkg-ref>
    <pkg-ref id="com.github.pschopen.concert7.app" version="@PKG_VERSION@">Concert7-app.pkg</pkg-ref>
</installer-gui-script>
